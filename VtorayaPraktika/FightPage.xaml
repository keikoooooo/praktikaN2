<Window x:Class="VtorayaPraktika.FightPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VtorayaPraktika"
        mc:Ignorable="d"
        Title="FightPage" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>

        <Button Margin="30" Grid.Column="0" Grid.Row="0">Конец Схватки</Button>

        <!-- Занимает всю оставшуюся высоту -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
 

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <Button Margin="4" Grid.Column="0" Grid.Row="0">Белый Ваза-aри</Button>
            <Button Margin="4" Grid.Column="1" Grid.Row="0">Красный Ваза-aри</Button>
            <Button Margin="4" Grid.Column="0" Grid.Row="1">Белый иппон</Button>
            <Button Margin="4" Grid.Column="1" Grid.Row="1">Красный иппон</Button>
            <Button Margin="4" Grid.Column="0" Grid.Row="2">Белый предупреждение</Button>
            <Button Margin="4" Grid.Column="1" Grid.Row="2">Красный предупреждение</Button>
        </Grid>
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
            <Border HorizontalAlignment="Right" Margin="10" Width="100" Background="Gray">
                <TextBlock HorizontalAlignment="Center">Татами 2</TextBlock>
            </Border>
            <Button Margin="10">Запуск большого таймера</Button>
            <Button Margin="10">Запуск малого таймера</Button>

        </StackPanel>
        <StackPanel Margin="10" Background ="LightGray" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Label HorizontalAlignment="Center" VerticalAlignment="Center">Схватка номер i</Label>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center"> На татами: вес: возраст: пол: Фамилия 1 - Фамилия 2</Label>
            <Label HorizontalAlignment="Left" VerticalAlignment="Center">Готовятся: вес: возраст: пол: Фамилия 1 - Фамилия 2</Label>
            <WrapPanel Orientation="Horizontal">
                <Label FontSize="72">0 : 0</Label>
                <StackPanel Margin=" 5">
                    <Label FontSize="36">20</Label>
                    <Button>Старт</Button>
                    <Button>Пауза</Button>

                </StackPanel>
                <StackPanel Margin=" 5">
                    <Label FontSize="72">2:00</Label>
                    <Button>Старт</Button>
                </StackPanel>
                <Label  FontSize="36">Наказания</Label>
            </WrapPanel>

        </StackPanel>
    </Grid>
</Window>