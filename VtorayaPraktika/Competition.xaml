<Window x:Class="VtorayaPraktika.Competition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VtorayaPraktika"
        mc:Ignorable="d"
        Title="Competition" Height="900" Width="1600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="*"/>
            <!-- upcoming -->
            <!-- footer / controls if needed -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ СТОРОНА (Белый) ===== -->
        <StackPanel Grid.Column="0" Margin="10">

            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0 0 0 25">
                <TextBlock Text="Возрастная категория – Пол – Весовая категория" FontSize="26"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0 0 0 25">
                <TextBlock Text="Белый: участник 1 (имя + название клуба)" FontSize="26"/>
            </Border>

            <!-- Баллы белого -->
            <Grid Margin="0 0 0 25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Белый иппон" FontSize="22"/>
                </Border>

                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Белый ваза-ари" FontSize="22"/>
                </Border>

                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Белый предупреждение" FontSize="20"/>
                </Border>
            </Grid>

            <!-- Время удержания белого -->
            <Border BorderBrush="Black" BorderThickness="2" Padding="10">
                <TextBlock Text="Время удержания в секундах" FontSize="40" HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>

        <Border Grid.Column ="0"  Grid.Row="1" BorderBrush="Black" BorderThickness="2" Padding="20" Margin="0 20">
            <TextBlock Text="Время в секундах" FontSize="80" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Column ="1"  Grid.Row="1" BorderBrush="Black" BorderThickness="2" Padding="20" Margin="0 20">
            <TextBlock Text="Время в секундах" FontSize="80" HorizontalAlignment="Center"/>
        </Border>

        <!-- ===== ПРАВАЯ СТОРОНА (Красный) ===== -->
        <StackPanel Grid.Column="1" Margin="10">

            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0 0 0 25">
                <TextBlock Text="Возрастная категория – Пол – Весовая категория" FontSize="26"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="2" Padding="10" Margin="0 0 0 25">
                <TextBlock Text="Красный: участник 2 (имя + название клуба)" FontSize="26"/>
            </Border>

            <!-- Баллы красного -->
            <Grid Margin="0 0 0 25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Красный иппон" FontSize="22"/>
                </Border>

                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Красный ваза-ари" FontSize="22"/>
                </Border>

                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="5">
                    <TextBlock Text="Красный предупреждение" FontSize="20"/>
                </Border>
            </Grid>

            <!-- Время удержания -->
            <Border BorderBrush="Black" BorderThickness="2" Padding="10">
                <TextBlock Text="Время удержания в секундах" FontSize="40" HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>
    </Grid>
</Window>
